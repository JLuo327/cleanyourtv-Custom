<?xml version="1.0" encoding="utf-8"?>
<!-- One cell of the control-centre grid: 156 x 84, glyph over name, inside its own frame.

     Landscape rather than square: a control is a switch you read left to right (glyph, then what it
     switches), and 2 x 156dp still fits the pill's 352dp panel while keeping the grid a clear
     two-up shape. The glyph is 30dp — the new icons carry their weight in the body of the shape, so
     they read better a little larger than the 28dp the outline set used. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="156dp"
    android:layout_height="84dp"
    android:layout_margin="4dp"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/control_tile_bg_dark"
    android:focusable="true"
    android:clickable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginBottom="9dp"
        android:tint="@drawable/pill_text"
        android:duplicateParentState="true"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center"
        android:textColor="@drawable/pill_text"
        android:duplicateParentState="true"
        android:textSize="14sp"
        android:fontFamily="@font/inter_medium"
        android:letterSpacing="0.01"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>
