<?xml version="1.0" encoding="utf-8"?>
<!-- Menu panel. Nothing clips: a focused row lifts by a few percent, and clipping would shave the
     ring off at the left and right edges.

     wrap_content on the panel and the rows: the menu hugs its longest row instead of stretching to
     a fixed width with empty glass on the right — the compact tvOS shape. The rows themselves stay
     match_parent, so they fill the panel the popup measures out and remain uniform. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:padding="8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/rows"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false" />
</LinearLayout>
