<?xml version="1.0" encoding="utf-8"?>
<!-- One row of a menu. Compact on purpose: the icon carries some of the weight the little icons
     inside a folder carry, the label drops a step further, and the row itself is slimmer —
     together they read as a tvOS action sheet rather than a list of footnotes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:layout_marginTop="1dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:background="@drawable/input_row_bg"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:tint="@drawable/pill_text"
        android:duplicateParentState="true"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        android:textColor="@drawable/pill_text"
        android:duplicateParentState="true"
        android:textSize="13sp"
        android:fontFamily="@font/inter_medium"
        android:letterSpacing="0.005"
        android:singleLine="true"
        android:ellipsize="end" />

    <View
        android:id="@+id/dot"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/status_dot" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@drawable/pill_text_dim"
        android:duplicateParentState="true"
        android:textSize="10sp"
        android:fontFamily="@font/inter_regular"
        android:letterSpacing="0.04" />
</LinearLayout>
