<?xml version="1.0" encoding="utf-8"?>
<!-- Settings backdrop. It used to be flat slate blue (#101419), which fought every other screen;
     this is the same near-black the control panel and the menus wear, with a little lift at the top
     so the page does not look like a hole. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FF16161A"
        android:endColor="#FF08080A" />
</shape>
