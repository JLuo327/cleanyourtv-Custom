<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS control-centre tile: the same frosted square whether or not it has focus. Selecting one
     adds a hairline ring (and a small lift in code) instead of flooding it with white. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4DFFFFFF" android:endColor="#26FFFFFF" />
            <stroke android:width="1.5dp" android:color="#B3FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4DFFFFFF" android:endColor="#26FFFFFF" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
