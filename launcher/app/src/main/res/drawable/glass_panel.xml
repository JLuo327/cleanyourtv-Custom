<?xml version="1.0" encoding="utf-8"?>
<!-- Dialogs (rename, card prompt, menus) wear a slightly lighter sheet than the folder does: they are
     centred, sit on their own scrim, and have a title to separate. Same construction as panel_bg —
     translucent gradient, top sheen, hairline rim — with a 24dp radius because a centred box reads
     better rounder than a panel hanging off the top edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#D216161D"
                android:endColor="#BC09090D" />
            <stroke android:width="1.5dp" android:color="#3DFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#14FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
