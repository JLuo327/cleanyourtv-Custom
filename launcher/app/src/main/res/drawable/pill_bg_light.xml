<?xml version="1.0" encoding="utf-8"?>
<!-- The same rim on a bright wallpaper: still clear inside, but the hairline goes dark because a
     white one would vanish into the picture. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1.5dp" android:color="#B3000000" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#59000000" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
