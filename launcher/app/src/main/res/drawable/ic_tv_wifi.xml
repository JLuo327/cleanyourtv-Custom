<?xml version="1.0" encoding="utf-8"?>
<!-- Wi-Fi, redrawn at the weight tvOS uses: three concentric arcs at a solid 2.3dp stroke and a
     filled dot, all sharing one centre so the curves stay parallel. The old one was freehand cubic
     curves at 1.7dp, which is what made it read as clip art: the arcs did not share a centre, so
     the gaps between them wobbled, and 1.7dp was not enough ink for white on a dark tile. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="22dp" android:height="22dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M3.6,10.9 A11.9,11.9 0 0 1 20.4,10.9" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M6.3,13.6 A8.1,8.1 0 0 1 17.7,13.6" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M9.0,16.3 A4.2,4.2 0 0 1 15.0,16.3" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,17.2 a1.55,1.55 0 1 0 0,3.1 a1.55,1.55 0 1 0 0,-3.1z" />
</vector>
